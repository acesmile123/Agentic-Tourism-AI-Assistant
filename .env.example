APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+psycopg://tourism:tourism@postgres:5432/tourism
REDIS_URL=redis://redis:6379/0
# Production separation: memory, retrieval cache and rate-limit counters can use
# distinct logical DBs locally or distinct ElastiCache endpoints in AWS.
REDIS_MEMORY_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_RATE_LIMIT_URL=redis://redis:6379/2
REDIS_KEY_PREFIX=tourism
REDIS_MEMORY_TTL_SECONDS=3600
REDIS_CACHE_TTL_SECONDS=900
MEMORY_MESSAGE_LIMIT=6

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_HEADERS=false

# Optional JWT verification. Keep disabled until an identity provider issues tokens.
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=tourism-api

# Reuse your existing Qdrant Cloud cluster and collection.
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-me
COLLECTION_NAME=your-existing-collection
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
RETRIEVAL_K=25
RETRIEVAL_TOP_N=7
CONTEXT_MAX_CHARS=4500

COHERE_API_KEY=replace-me
COHERE_RERANK_MODEL=rerank-v4.0-pro
COHERE_TIMEOUT_SECONDS=10

# Optional agent tools. Tools without a key remain registered but unavailable.
OPENWEATHER_API_KEY=
GOONG_API_KEY=
GOONG_BASE_URL=https://rsapi.goong.io
TAVILY_API_KEY=
TOOL_HTTP_TIMEOUT_SECONDS=10

# Agent connects only to this MCP endpoint. In Compose use http://mcp:8001/mcp.
MCP_SERVER_URL=http://mcp:8001/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_READ_TIMEOUT_SECONDS=45
MCP_DISCOVERY_TTL_SECONDS=300
# Qdrant hybrid/RRF scores are collection-dependent; calibrate this with an eval set.
ADAPTIVE_RETRIEVAL_THRESHOLD=0.3
AGENT_MAX_RETRIES=1

# Optional observability. The app works normally when disabled or keys are empty.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

GEMINI_API_KEY=replace-me
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_COMPLEX_MODEL=gemini-3.6-flash
