# Copy to /opt/tourism-agent/.env.production on EC2. Do not commit real values.
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://chat.example.com

# Use AWS Secrets Manager/SSM to render these values on the host.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_ENDPOINT:5432/tourism?sslmode=require
REDIS_MEMORY_URL=rediss://ELASTICACHE_ENDPOINT:6379/0
REDIS_CACHE_URL=rediss://ELASTICACHE_ENDPOINT:6379/1
REDIS_RATE_LIMIT_URL=rediss://ELASTICACHE_ENDPOINT:6379/2
REDIS_KEY_PREFIX=tourism-prod

QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=
COLLECTION_NAME=
COHERE_API_KEY=
GEMINI_API_KEY=
GOONG_API_KEY=
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ENABLED=false
JWT_SECRET=
JWT_AUDIENCE=tourism-api

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
